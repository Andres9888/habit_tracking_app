## File: convex/templates/queries.ts
Replace the getPopular function (around line 40-51) with:
```typescript
/**
 * Query: Get popular templates (sorted by popularity score)
 * PERF: Uses by_popularity index for efficient sorting
 */
export const getPopular = query({
  args: { limit: v.optional(v.number()) },
  handler: async (ctx, args) => {
    const limit = args.limit || 10;
    
    // Use index for efficient sorting - descending order
    const templates = await ctx.db
      .query('templates')
      .withIndex('by_popularity')
      .order('desc')
      .take(limit * 2); // Take more to filter out undefined scores

    // Filter out templates without popularityScore and take final limit
    return templates
      .filter((t) => t.popularityScore !== undefined)
      .slice(0, limit);
  },
});
```
