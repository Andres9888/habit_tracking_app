{
  "metadata": {
    "storyId": "habit-strength-rework-v2",
    "epicId": "habit-tracking-core",
    "title": "Habit Strength Rework v2.0 - Momentum-Based Formula & Ring Visual",
    "priority": "high",
    "status": "approved",
    "created": "2025-12-07",
    "author": "John (PM)",
    "estimatedEffort": "6-9 hours",
    "storyPath": "docs/stories/habit-strength-rework-v2.md"
  },
  "overview": {
    "problem": "Current habit strength calculation is too punishing - missing a single day significantly drops the percentage, demotivating users.",
    "solution": "Replace with forgiving momentum-based formula and ring/arc visual display (Apple Watch style).",
    "keyChanges": [
      "New momentum-based strength formula with streak shield protection",
      "Ring/arc visual component replacing progress bar",
      "Graceful decay on misses (streak-protected)",
      "Same 90-day target to reach ~100% strength"
    ]
  },
  "acceptanceCriteria": [
    {
      "id": "AC1",
      "category": "formula",
      "description": "Completing a habit increases strength",
      "testCase": "50% → ~52.5% after completion",
      "priority": "must-have"
    },
    {
      "id": "AC2",
      "category": "formula",
      "description": "Missing a habit decreases strength",
      "testCase": "50% → ~48.75% after miss (with shield)",
      "priority": "must-have"
    },
    {
      "id": "AC3",
      "category": "formula",
      "description": "Streak shield reduces decay",
      "testCase": "7/7 week = 60% less decay than 0/7 week",
      "priority": "must-have"
    },
    {
      "id": "AC4",
      "category": "formula",
      "description": "90 days perfect = ~100%",
      "testCase": "Simulate 90 completions, verify ≥99%",
      "priority": "must-have"
    },
    {
      "id": "AC5",
      "category": "persistence",
      "description": "Strength persists in database",
      "testCase": "Reload app, strength unchanged",
      "priority": "must-have"
    },
    {
      "id": "AC6",
      "category": "reactivity",
      "description": "Strength updates on toggle",
      "testCase": "No page refresh needed",
      "priority": "must-have"
    },
    {
      "id": "AC7",
      "category": "visual",
      "description": "Ring displays on HabitCard",
      "testCase": "Visible in habit list",
      "priority": "must-have"
    },
    {
      "id": "AC8",
      "category": "visual",
      "description": "Ring fills proportionally",
      "testCase": "50% strength = half-filled ring",
      "priority": "must-have"
    },
    {
      "id": "AC9",
      "category": "visual",
      "description": "Color changes by level",
      "testCase": "<30% green-300, 30-59% green-400, 60-84% green-500, 85%+ green-700",
      "priority": "must-have"
    },
    {
      "id": "AC10",
      "category": "visual",
      "description": "Animation on change",
      "testCase": "Smooth spring animation when % changes (300ms)",
      "priority": "must-have"
    },
    {
      "id": "AC11",
      "category": "accessibility",
      "description": "Accessible",
      "testCase": "Screen reader announces '45% strength, Building level'",
      "priority": "must-have"
    }
  ],
  "artifacts": {
