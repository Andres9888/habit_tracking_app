  "interfaces": {
    "StrengthRingProps": {
      "strength": "number",
      "size": "'small' | 'medium'",
      "showPercentage": "boolean (optional)",
      "showLevel": "boolean (optional)"
    },
    "calculateNewStrength": {
      "params": {
        "currentStrength": "number (0-100)",
        "completed": "boolean",
        "completionsLast7Days": "number (0-7)"
      },
      "returns": "number (0-100)"
    }
  },
  "constraints": {
    "technical": [
      "Must use React Native Animated API or Reanimated for smooth ring animations",
      "Must use SVG for ring rendering (react-native-svg)",
      "Formula constants are fixed: GROWTH_RATE=0.05, BASE_DECAY=0.025, SHIELD_EFFECTIVENESS=0.6",
      "Ring must render at 60fps for smooth animation",
      "Convex mutations must be used for strength updates"
    ],
    "business": [
      "No data migration required - existing strength values remain valid",
      "New formula takes over from current values",
      "90-day target to 100% must be maintained",
      "Visual must work on iOS and Android"
    ],
    "accessibility": [
      "Screen readers must announce strength percentage and level",
      "Color must not be the only indicator (use labels)",
      "Minimum touch target 44x44 if ring is interactive"
    ],
    "performance": [
      "Strength calculation must complete in <10ms",
      "Ring render must not block UI thread",
      "Animation must maintain 60fps"
    ]
  },
  "outOfScope": [
    "Multiple rings (daily/weekly/monthly)",
    "Custom frequency habits (3x per week)",
    "Plateau prevention mechanics",
    "Weekday vs weekend patterns",
    "Recalculating existing user strengths from history"
  ],
  "dependencies": {
    "external": [
      "react-native-svg (for ring rendering)",
      "react-native-reanimated (for animations, if not already present)"
    ],
    "internal": [
      "Convex backend (habitStrength.ts, tracking.ts)",
      "Existing habit data model"
    ]
  },
