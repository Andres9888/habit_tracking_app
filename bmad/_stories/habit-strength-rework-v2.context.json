        "type": "backend-logic",
        "action": "modify",
        "description": "Replace formula with new momentum-based calculation",
        "changes": [
          "Implement calculateNewStrength function with GROWTH_RATE=0.05, BASE_DECAY=0.025, SHIELD_EFFECTIVENESS=0.6",
          "Add completionsLast7Days parameter for streak shield calculation",
          "Ensure growth fills 5% of gap to 100, decay protected by recent consistency"
        ]
      },
      {
        "path": "convex/tracking.ts",
        "type": "backend-logic",
        "action": "modify",
