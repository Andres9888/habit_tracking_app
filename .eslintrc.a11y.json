{
  "extends": [".eslintrc.js"],
  "plugins": ["react-native-a11y"],
  "rules": {
    "react-native-a11y/has-accessibility-hint": "warn",
    "react-native-a11y/has-accessibility-props": "warn",
    "react-native-a11y/has-valid-accessibility-actions": "error",
    "react-native-a11y/has-valid-accessibility-role": "error",
    "react-native-a11y/has-valid-accessibility-state": "error",
    "react-native-a11y/has-valid-accessibility-value": "error",
    "react-native-a11y/has-valid-accessibility-live-region": "error",
    "react-native-a11y/no-nested-touchables": "error",
    "react-native-a11y/has-valid-accessibility-ignores-invert-colors": "warn"
  },
  "overrides": [
    {
      "files": ["*.tsx", "*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "JSXElement[openingElement.name.name='Text']:not([openingElement.attributes.length>0]):not(:has(JSXAttribute[name.name='maxFontSizeMultiplier']))",
            "message": "Text components should include maxFontSizeMultiplier to prevent layout breaking with large font sizes. Use AccessibleText component or add maxFontSizeMultiplier={2.0}"
          },
          {
            "selector": "JSXElement[openingElement.name.name='Image']:not(:has(JSXAttribute[name.name=/accessibility/]))",
            "message": "Image components should have accessibilityLabel (meaningful images) or accessibilityElementsHidden (decorative images)"
          }
        ]
      }
    }
  ]
}
