{
  "expo": {
    "name": "Chain Day",
    "slug": "chain-day",
    "scheme": "chain-day",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F1ED"
    },
    "assetBundlePatterns": ["**/*"],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andres9888.daily-habits",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1ED"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {}
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for voice note recordings."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to create your Vision Board.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to capture images for your Vision Board."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "chain-day",
          "project": "react-native"
        }
      ]
    ]
  }
}
