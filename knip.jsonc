{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.ts",
    "src/main.tsx",
    "convex/**/*.ts",
    "scripts/**/*.{js,mjs,cjs,ts}",
    "plugins/**/*.{js,mjs,cjs,ts}",
    "__tests__/**/*.{js,jsx,ts,tsx}",
    "tests/**/*.{js,jsx,ts,tsx}",
    "__mocks__/**/*.{js,jsx,ts,tsx}",
    "jest.config.js",
    "jest.setup.js",
    "babel.config.cjs",
    "metro.config.cjs"
  ],
  "project": [
    "index.ts",
    "nativewind-env.d.ts",
    "src/**/*.{js,jsx,ts,tsx}",
    "convex/**/*.{js,jsx,ts,tsx}",
    "scripts/**/*.{js,mjs,cjs,ts}",
    "plugins/**/*.{js,mjs,cjs,ts}",
    "__tests__/**/*.{js,jsx,ts,tsx}",
    "tests/**/*.{js,jsx,ts,tsx}",
    "__mocks__/**/*.{js,jsx,ts,tsx}"
  ],
  "ignore": [
    "automaker/**",
    "website/**",
    "docs/**",
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "android/**",
    "ios/**",
    "assets/**",
    "Substrate/**",
    "worktrees/**",
    "MEMORY/**",
    "Auto Run Docs/**",
    "Plans/**",
    "specs/**",
    "superdesign/**",
    ".superdesign/**",
    "bmad/**"
  ]
}
