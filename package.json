{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --once && node setup.mjs && npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "mcp": "convex mcp start --project-dir .",
    "mcp:custom": "node convex-mcp-server.js",
    "deploy": "convex deploy --prod",
    "deploy:preview": "convex deploy --preview",
    "expo:start": "./scripts/export-env.sh -- npx expo start",
    "expo:ios": "./scripts/export-env.sh -- npx expo start --ios",
    "expo:android": "./scripts/export-env.sh -- npx expo start --android",
    "lint": "tsc -p tsconfig.app.json -noEmit --pretty false && convex dev --once && vite build",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,html,yml,yaml}\"",
    "format:staged": "prettier --write",
    "check:all": "npm run format:check && npm run lint",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@clerk/clerk-expo": "^2.15.4",
    "@convex-dev/auth": "^0.0.90",
    "@expo/vector-icons": "^15.0.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/native": "^7.1.18",
    "@shopify/react-native-skia": "^2.2.12",
    "bmad-method": "^6.0.0-alpha.0",
    "clsx": "^2.1.1",
    "convex": "1.21.1-alpha.1",
    "date-fns": "^4.1.0",
    "expo": "54.0.20",
    "expo-auth-session": "^7.0.8",
    "expo-blur": "~15.0.7",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-notifications": "~0.32.12",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "^14.0.7",
    "expo-status-bar": "^3.0.8",
    "expo-web-browser": "~15.0.8",
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.545.0",
    "react": "19.1.0",
    "react-calendar": "^5.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "reanimated-color-picker": "^4.1.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
    "victory-native": "^41.20.1"
  },
  "overrides": {
    "convex": "1.21.1-alpha.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^15.15.0",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.12",
    "nativewind": "^4.1.23",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-native-css-interop": "^0.2.1",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
