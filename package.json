{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --once --env-file .env.local && node setup.mjs && npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm run expo:start -- --web",
    "dev:backend": "convex dev --env-file .env.local",
    "mcp": "convex mcp start --project-dir .",
    "mcp:custom": "node convex-mcp-server.js",
    "deploy": "convex deploy --prod",
    "deploy:preview": "convex deploy --preview",
    "expo:start": "bash scripts/expo-start.sh",
    "expo:ios": "bash scripts/expo-start.sh --ios",
    "expo:android": "bash scripts/expo-start.sh --android",
    "lint": "convex codegen --typecheck disable && tsc -p tsconfig.app.json -noEmit --pretty false && ./scripts/export-env.sh -- npx expo export -p web",
    "lint:fix": "eslint . --fix",
    "lint:eslint": "eslint src convex --format stylish",
    "lint:max-lines": "eslint . --format stylish 2>&1 | grep -E 'max-lines' || echo 'All files compliant!'",
    "lint:max-lines-report": "eslint . --format json > .eslint-max-lines-report.json || true",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css,html,yml,yaml}\"",
    "format:staged": "prettier --write",
    "check:all": "npm run format:check && npm run lint",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run test:scenarios && npm run test:e2e:maestro:smoke",
    "test:e2e:maestro": "JAVA_HOME=${JAVA_HOME:-$HOME/java/jdk-21.0.10+7/Contents/Home} maestro test .maestro/e2e",
    "test:e2e:maestro:smoke": "JAVA_HOME=${JAVA_HOME:-$HOME/java/jdk-21.0.10+7/Contents/Home} maestro test --include-tags smoke .maestro/e2e",
    "test:security": "jest --testPathPattern=security --coverage",
    "test:security:fast": "jest --testPathPattern=security --runInBand --coverage=false",
    "test:performance": "jest --testPathPattern=performance --coverage",
    "test:scenarios": "jest -c tests/e2e-scenarios/jest.scenarios.config.cjs --forceExit",
    "perf:budget": "npm run test:performance && npm run lint:max-lines",
    "perf:bundle-check": "echo 'Run: find src app -name \"*.ts\" -o -name \"*.tsx\" | xargs wc -c | tail -1'",
    "audit:deps": "npm audit --audit-level=high",
    "audit:deps:json": "npm audit --json > audit-results.json || true",
    "audit:deps:fix": "npm audit fix",
    "audit:deps:report": "npm audit --json | jq '.metadata.vulnerabilities'",
    "audit:licenses": "npx license-checker --production --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Unlicense;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Python-2.0;PSF-2.0;BlueOak-1.0.0\"",
    "audit:outdated": "npm outdated --json | jq 'to_entries | map(select(.value.current != .value.latest)) | from_entries' || true",
    "scan:secrets": "./scripts/security-gitleaks.sh",
    "scan:secrets:history": "GITLEAKS_SCAN_MODE=git-history ./scripts/security-gitleaks.sh",
    "audit:security": "npm run audit:deps && npm run test:security:fast && npm run scan:secrets",
    "migrate:normalize-reminder-times": "bash scripts/migrate-reminder-times.sh",
    "postinstall": "patch-package",
    "prepare": "husky",
    "lint:dead": "knip",
    "build": "expo export --platform all",
    "analyze:bundle": "EXPO_UNSTABLE_ATLAS=true expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@clerk/expo": "^3.7.5",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@expo-google-fonts/literata": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@sentry/react-native": "~7.2.0",
    "clsx": "^2.1.1",
    "convex": "1.21.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-av": "^16.0.8",
    "expo-background-task": "~1.0.10",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.7",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "^14.0.7",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "^9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.564.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-purchases": "9.7.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "sonner": "^2.0.3",
    "victory-native": "^41.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@factory/eslint-plugin": "^0.1.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-no-barrel-files": "^1.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "knip": "^6.24.0",
    "lint-staged": "^16.2.7",
    "nativewind": "^4.1.23",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react-native-css-interop": "^0.2.1",
    "tailwindcss": "^3.4.18",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "convex": "1.21.0",
    "minimatch": "^10.2.4",
    "rollup": "^4.59.0",
    "tar": "^7.5.10",
    "test-exclude": {
      "minimatch": "^5.1.6"
    },
    "ws": "^8.21.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
