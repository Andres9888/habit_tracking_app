{
  "$schema": "https://figma.com/community/plugin/888356646278934516",
  "name": "Habit Tracker Component Specifications",
  "version": "1.0.0",
  "description": "Figma component specifications with variants and properties",

  "components": {
    "HabitCard": {
      "name": "HabitCard",
      "description": "Display individual habit with all tracking info",
      "properties": {
        "state": {
          "type": "variant",
          "values": ["default", "completed", "atRisk", "pressed", "disabled"]
        },
        "size": {
          "type": "variant",
          "values": ["small", "standard", "large"]
        }
      },
      "layout": {
        "type": "auto-layout",
        "direction": "horizontal",
        "spacing": "8pt",
        "padding": {
          "top": "16pt",
          "right": "16pt",
          "bottom": "16pt",
          "left": "20pt"
        },
        "height": {
          "small": "68pt",
          "standard": "72pt",
          "large": "76pt"
        },
        "cornerRadius": "12pt",
        "fill": {
          "default": "#FFFFFF",
          "completed": "rgba(16, 185, 129, 0.1)"
        },
        "effects": [
          {
            "type": "DROP_SHADOW",
            "visible": true,
            "color": "rgba(0, 0, 0, 0.1)",
            "offset": { "x": 0, "y": 2 },
            "radius": 8,
            "spread": 0
          }
        ]
      },
      "children": [
        {
          "name": "accent-bar",
          "type": "rectangle",
          "width": "4pt",
          "height": "100%",
          "fill": "$colors.brand.primary.500",
          "cornerRadius": "4pt 0 0 4pt",
          "constraints": {
            "vertical": "stretch",
            "horizontal": "left"
          }
        },
        {
          "name": "icon",
          "type": "frame",
          "width": "32pt",
          "height": "32pt",
          "cornerRadius": "8pt",
          "fill": "$colors.brand.primary.500",
          "constraints": {
            "vertical": "center",
            "horizontal": "left"
          }
        },
        {
          "name": "content",
          "type": "auto-layout",
          "direction": "vertical",
          "spacing": "4pt",
          "fill": "transparent",
          "layoutGrow": 1,
          "children": [
            {
              "name": "habit-name",
              "type": "text",
              "content": "Morning Meditation",
              "style": "$typography.h3",
              "fill": "$colors.gray.700"
            },
            {
              "name": "strength-indicator",
              "type": "component-instance",
              "component": "HabitStrengthIndicator",
              "variant": "compact"
            }
          ]
        },
        {
          "name": "status-icon",
          "type": "frame",
          "width": "24pt",
          "height": "24pt",
          "constraints": {
            "vertical": "center",
            "horizontal": "right"
          }
        }
      ],
      "interactions": [
        {
          "trigger": "on-tap",
          "action": "toggle-completion",
          "animation": {
            "type": "smart-animate",
            "duration": "600ms",
            "easing": "spring"
          }
        },
        {
          "trigger": "while-pressing",
          "action": "scale",
          "scale": 0.95,
          "animation": {
            "duration": "100ms",
            "easing": "ease-out"
          }
        }
      ]
    },

    "HabitStrengthIndicator": {
      "name": "HabitStrengthIndicator",
      "description": "Visualize habit strength with science-backed metrics",
      "properties": {
        "type": {
          "type": "variant",
          "values": ["compact", "full", "graph"]
        },
        "level": {
          "type": "variant",
          "values": ["starting", "building", "developing", "strong", "automatic"]
        },
        "strength": {
          "type": "number",
          "min": 0,
          "max": 100,
          "default": 50
        }
      },
      "variants": {
        "compact": {
          "layout": {
            "type": "auto-layout",
            "direction": "horizontal",
            "spacing": "8pt",
            "primaryAxisSizing": "fill-container"
          },
          "children": [
            {
              "name": "emoji",
              "type": "text",
              "fontSize": "24pt",
              "content": {
                "starting": "🌱",
                "building": "🌿",
                "developing": "🌳",
                "strong": "💪",
                "automatic": "⚡"
              }
            },
            {
              "name": "progress-bar",
              "type": "frame",
              "layoutGrow": 1,
              "height": "8pt",
              "cornerRadius": "4pt",
              "fill": "$colors.gray.200",
              "children": [
                {
                  "name": "fill",
                  "type": "rectangle",
                  "height": "8pt",
                  "width": "{{strength}}%",
                  "cornerRadius": "4pt",
                  "fill": {
                    "starting": "$colors.strength.starting",
                    "building": "$colors.strength.building",
                    "developing": "$colors.strength.developing",
                    "strong": "$colors.strength.strong",
                    "automatic": "$colors.strength.automatic"
                  }
                }
              ]
            },
            {
              "name": "percentage",
              "type": "text",
              "content": "{{strength}}%",
              "fontFamily": "SF Mono",
              "fontSize": "15pt",
              "fill": "$colors.gray.600"
            }
          ]
        },
        "full": {
          "layout": {
            "type": "auto-layout",
            "direction": "vertical",
            "spacing": "16pt",
            "primaryAxisAlign": "center",
            "counterAxisAlign": "center",
            "padding": "24pt"
          },
          "children": [
            {
              "name": "emoji",
              "type": "text",
              "fontSize": "64pt",
              "content": {
                "starting": "🌱",
                "building": "🌿",
                "developing": "🌳",
                "strong": "💪",
                "automatic": "⚡"
              },
              "effects": [
                {
                  "type": "DROP_SHADOW",
                  "visible": true,
                  "color": "rgba(16, 185, 129, 0.3)",
                  "offset": { "x": 0, "y": 4 },
                  "radius": 12,
                  "spread": 0
                }
              ]
            },
            {
              "name": "level-label",
              "type": "text",
              "content": {
                "starting": "Starting",
                "building": "Building",
                "developing": "Developing",
                "strong": "Strong",
                "automatic": "Automatic"
              },
              "style": "$typography.h2",
              "fill": "$colors.gray.700"
            },
            {
              "name": "progress-bar",
              "type": "frame",
              "width": "280pt",
              "height": "12pt",
              "cornerRadius": "6pt",
              "fill": "$colors.gray.200",
              "children": [
                {
                  "name": "fill",
                  "type": "rectangle",
                  "height": "12pt",
                  "width": "{{strength}}%",
                  "cornerRadius": "6pt",
                  "fill": {
                    "starting": "$colors.strength.starting",
                    "building": "$colors.strength.building",
                    "developing": "$colors.strength.developing",
                    "strong": "$colors.strength.strong",
                    "automatic": "$colors.strength.automatic"
                  }
                }
              ]
            },
            {
              "name": "percentage",
              "type": "text",
              "content": "{{strength}}% Strength",
              "fontFamily": "SF Mono",
              "fontSize": "17pt",
              "fill": "$colors.gray.600"
            }
          ]
        }
      }
    },

    "Button": {
      "name": "Button",
      "description": "Primary interaction element",
      "properties": {
        "type": {
          "type": "variant",
          "values": ["primary", "secondary", "ghost", "icon"]
        },
        "state": {
          "type": "variant",
          "values": ["default", "pressed", "disabled", "loading"]
        },
        "size": {
          "type": "variant",
          "values": ["small", "medium", "large"]
        }
      },
      "variants": {
        "primary": {
          "layout": {
            "type": "auto-layout",
            "direction": "horizontal",
            "spacing": "8pt",
            "padding": {
              "horizontal": "16pt",
              "vertical": "12pt"
            },
            "primaryAxisAlign": "center",
            "counterAxisAlign": "center",
            "height": {
              "small": "32pt",
              "medium": "44pt",
              "large": "56pt"
            },
            "cornerRadius": "12pt",
            "fill": {
              "default": "$colors.brand.primary.500",
              "pressed": "$colors.brand.primary.600",
              "disabled": "$colors.gray.300"
            }
          },
          "children": [
            {
              "name": "icon",
              "type": "icon",
              "size": "20pt",
              "visible": "optional",
              "fill": "#FFFFFF"
            },
            {
              "name": "label",
              "type": "text",
              "content": "Button Text",
              "style": "$typography.button",
              "fill": {
                "default": "#FFFFFF",
                "disabled": "$colors.gray.500"
              }
            },
            {
              "name": "spinner",
              "type": "component-instance",
              "component": "Spinner",
              "size": "20pt",
              "visible": "{{state === 'loading'}}",
              "fill": "#FFFFFF"
            }
          ],
          "interactions": [
            {
              "trigger": "while-pressing",
              "action": "scale",
              "scale": 0.95,
              "animation": {
                "duration": "100ms",
                "easing": "ease-out"
              }
            }
          ]
        },
        "secondary": {
          "layout": {
            "type": "auto-layout",
            "direction": "horizontal",
            "spacing": "8pt",
            "padding": {
              "horizontal": "16pt",
              "vertical": "12pt"
            },
            "height": {
              "small": "32pt",
              "medium": "44pt",
              "large": "56pt"
            },
            "cornerRadius": "12pt",
            "fill": "transparent",
            "stroke": {
              "width": "2pt",
              "color": {
                "default": "$colors.brand.primary.500",
                "pressed": "$colors.brand.primary.600",
                "disabled": "$colors.gray.300"
              }
            }
          },
          "children": [
            {
              "name": "label",
              "type": "text",
              "content": "Button Text",
              "style": "$typography.button",
              "fill": {
                "default": "$colors.brand.primary.500",
                "pressed": "$colors.brand.primary.600",
                "disabled": "$colors.gray.500"
              }
            }
          ]
        },
        "ghost": {
          "layout": {
            "type": "auto-layout",
            "direction": "horizontal",
            "spacing": "8pt",
            "padding": {
              "horizontal": "16pt",
              "vertical": "12pt"
            },
            "height": {
              "small": "32pt",
              "medium": "44pt",
              "large": "56pt"
            },
            "fill": "transparent"
          },
          "children": [
            {
              "name": "label",
              "type": "text",
              "content": "Button Text",
              "style": "$typography.button",
              "fill": {
                "default": "$colors.brand.primary.500",
                "pressed": "$colors.brand.primary.600",
                "disabled": "$colors.gray.500"
              }
            }
          ]
        }
      }
    },

    "Modal": {
      "name": "Modal",
      "description": "Overlay screens for focused tasks",
      "properties": {
        "type": {
          "type": "variant",
          "values": ["bottomSheet", "fullScreen", "centerAlert"]
        },
        "state": {
          "type": "variant",
          "values": ["entering", "open", "exiting"]
        }
      },
      "variants": {
        "bottomSheet": {
          "layout": {
            "type": "frame",
            "width": "100%",
            "height": "auto",
            "cornerRadius": "20pt 20pt 0 0",
            "fill": "$colors.surface.modal",
            "effects": [
              {
                "type": "DROP_SHADOW",
                "visible": true,
                "color": "rgba(0, 0, 0, 0.12)",
                "offset": { "x": 0, "y": 4 },
                "radius": 16,
                "spread": 0
              }
            ]
          },
          "children": [
            {
              "name": "handle",
              "type": "rectangle",
              "width": "40pt",
              "height": "4pt",
              "cornerRadius": "2pt",
              "fill": "$colors.gray.300",
              "constraints": {
                "horizontal": "center",
                "vertical": "top"
              },
              "position": {
                "x": "center",
                "y": "8pt"
              }
            },
            {
              "name": "content",
              "type": "auto-layout",
              "direction": "vertical",
              "spacing": "24pt",
              "padding": "24pt",
              "paddingTop": "32pt"
            }
          ],
          "interactions": [
            {
              "trigger": "on-open",
              "action": "slide-up",
              "animation": {
                "type": "smart-animate",
                "duration": "300ms",
                "easing": "spring"
              }
            },
            {
              "trigger": "on-close",
              "action": "slide-down",
              "animation": {
                "type": "smart-animate",
                "duration": "250ms",
                "easing": "spring"
              }
            }
          ]
        },
        "fullScreen": {
          "layout": {
            "type": "frame",
            "width": "100%",
            "height": "100%",
            "fill": "$colors.surface.background"
          },
          "children": [
            {
              "name": "navigation-bar",
              "type": "auto-layout",
              "direction": "horizontal",
              "spacing": "16pt",
              "padding": "16pt",
              "height": "64pt",
              "constraints": {
                "horizontal": "stretch",
                "vertical": "top"
              }
            },
            {
              "name": "content",
              "type": "frame",
              "constraints": {
                "horizontal": "stretch",
                "vertical": "stretch"
              }
            }
          ],
          "interactions": [
            {
              "trigger": "on-open",
              "action": "slide-from-right",
              "animation": {
                "type": "smart-animate",
                "duration": "300ms",
                "easing": "spring"
              }
            }
          ]
        }
      }
    },

    "Card": {
      "name": "Card",
      "description": "Group related information",
      "properties": {
        "type": {
          "type": "variant",
          "values": ["default", "highlighted", "stat"]
        },
        "state": {
          "type": "variant",
          "values": ["default", "pressed", "disabled"]
        }
      },
      "layout": {
        "type": "auto-layout",
        "direction": "vertical",
        "spacing": "8pt",
        "padding": "16pt",
        "cornerRadius": "12pt",
        "fill": "$colors.surface.card",
        "effects": [
          {
            "type": "DROP_SHADOW",
            "visible": true,
            "color": "rgba(0, 0, 0, 0.1)",
            "offset": { "x": 0, "y": 2 },
            "radius": 8,
            "spread": 0
          }
        ]
      },
      "variants": {
        "stat": {
          "children": [
            {
              "name": "icon",
              "type": "frame",
              "width": "32pt",
              "height": "32pt"
            },
            {
              "name": "value",
              "type": "text",
              "content": "5 Habits",
              "style": "$typography.h2",
              "fill": "$colors.gray.700"
            },
            {
              "name": "label",
              "type": "text",
              "content": "Active",
              "style": "$typography.body-small",
              "fill": "$colors.gray.500"
            }
          ]
        }
      }
    },

    "Toast": {
      "name": "Toast",
      "description": "Brief, non-blocking feedback messages",
      "properties": {
        "type": {
          "type": "variant",
          "values": ["success", "error", "info", "warning", "undo"]
        },
        "state": {
          "type": "variant",
          "values": ["entering", "visible", "exiting"]
        }
      },
      "layout": {
        "type": "auto-layout",
        "direction": "horizontal",
        "spacing": "12pt",
        "padding": {
          "horizontal": "16pt",
          "vertical": "12pt"
        },
        "cornerRadius": "12pt",
        "fill": "rgba(31, 41, 55, 0.9)",
        "effects": [
          {
            "type": "DROP_SHADOW",
            "visible": true,
            "color": "rgba(0, 0, 0, 0.1)",
            "offset": { "x": 0, "y": 2 },
            "radius": 8,
            "spread": 0
          }
        ]
      },
      "children": [
        {
          "name": "icon",
          "type": "icon",
          "size": "20pt",
          "fill": {
            "success": "$colors.semantic.success",
            "error": "$colors.semantic.error",
            "info": "$colors.semantic.info",
            "warning": "$colors.semantic.warning"
          }
        },
        {
          "name": "message",
          "type": "text",
          "content": "Toast message",
          "style": "$typography.body-small",
          "fill": "#FFFFFF",
          "layoutGrow": 1
        },
        {
          "name": "action-button",
          "type": "text",
          "content": "Undo",
          "style": "$typography.button",
          "fill": "$colors.brand.primary.400",
          "visible": "{{type === 'undo'}}"
        }
      ],
      "interactions": [
        {
          "trigger": "on-appear",
          "action": "slide-up",
          "animation": {
            "duration": "200ms",
            "easing": "ease-out"
          }
        },
        {
          "trigger": "on-dismiss",
          "action": "slide-down-fade",
          "animation": {
            "duration": "200ms",
            "easing": "ease-in"
          }
        }
      ]
    }
  }
}
