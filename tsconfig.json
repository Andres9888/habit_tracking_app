{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "nativewind-env.d.ts"],
  "exclude": ["website", "tests", "__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
