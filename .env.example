# =========================================================================
# ChainDay — product environment variables
# =========================================================================
# These are the vars the app itself reads at runtime. Copy this file to
# .env.local and fill in real values. Never commit real values.
#
# Dev-tooling vars (Task Master LLM keys, etc.) live in
# .env.taskmaster.example — they are NOT required to run the app.
# -------------------------------------------------------------------------

# --- Clerk (authentication) ---
# Client-side publishable key (SEC-001). Format: pk_test_... or pk_live_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key_here"
# Backend-side Clerk domain used by Convex to verify JWTs. Read by
# convex/auth.config.ts; must be set in the Convex dashboard in prod.
CLERK_AUTH_DOMAIN="https://your-domain.clerk.accounts.dev"

# --- Convex (backend) ---
EXPO_PUBLIC_CONVEX_URL="https://your-deployment.convex.cloud"

# --- RevenueCat (subscriptions) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY="your_revenuecat_ios_public_sdk_key"
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY="your_revenuecat_android_public_sdk_key"
# Webhook shared secret (SEC-002). MUST be set in the Convex dashboard,
# NEVER on the client. Without it, the webhook handler rejects every
# request.
REVENUECAT_WEBHOOK_SECRET="your_revenuecat_webhook_shared_secret"

# --- Sentry (error reporting) ---
EXPO_PUBLIC_SENTRY_DSN="your_sentry_dsn_here"
# Privacy-reviewed advanced monitoring controls. Keep disabled unless App Store
# privacy labels and Sentry quota/budget have been reviewed.
EXPO_PUBLIC_SENTRY_ENABLE_REPLAY="false"
EXPO_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0.01"
EXPO_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="1"
EXPO_PUBLIC_SENTRY_ENABLE_PROFILING="false"
EXPO_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE="0.1"
EXPO_PUBLIC_SENTRY_ENABLE_LOGS="false"
# Build-only secret for production EAS source-map/native-symbol upload.
# Set with `eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value ...`.
SENTRY_AUTH_TOKEN="your_sentry_auth_token_here"
